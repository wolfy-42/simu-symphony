//-------------------------------------------------------------------
// Description   : This INCLUDE library is responsible for implementing tasks that
//                 aid in simulation logfile and flowcontrol
//
//   Usage: intended for inline `include in testbench/testcase 
//
//     (NOTE: NOT a standalone module!)
//
//   Dependancies:  
//    1> tb/libraries/sim_management_inst.v   
//
//   Available User routines:
//    - function automatic integer clogb2(input integer depth);
//    - function void printDebugMsg (input string caller, 
//                                   input string msg);
//    - task tCheckSig (  input string  caller ,               // string label of calling module/procedure
//                        input integer errlvl ,               // error level responce (0-2)
//                        input string  sname ,                // string of signal name being checked
//                        input integer unsigned realval ,     // realvalnal to be checked
//                        input integer unsigned expval );     // correct value expvalected (fault if actual != expvalected)
//    - task sub_test_fault_chk (input string testcase, 
//                               input string test_name);
//
// Updated       : 2015-08-10 / Arnold B. - fixes
// Updated       : date / author - comments
//--------------------------------------------------------------------

//<> check to see if module already included by calling module...avoids duplicate includes
`ifndef SIM_TOOLS
   `define SIM_TOOLS

   //<> define standard alias to logfile output routines (if not already defined)
   `ifndef SIM   
      `define SIM  tb.sim_management_inst
   `endif

    
   // -------------------------------------------------------------------
   // <> constant function routine to calculate the width of a bus/vector given the 
   //    integer range to be held by that bus
   //  eg.  parameter RAM_DEPTH = 256;
   //       input [clogb2(RAM_DEPTH)-1:0] addr_bus;
   //
   function automatic integer clogb2(input integer depth);
   begin
      for (clogb2=0; depth > 0; clogb2=clogb2+1)
         depth = depth >> 1;
   end
   endfunction

   //* Task printDebugMsg
   // Purpose: To print the input debug message in a standard format, starting with the 
   //          name of the module which invoked this task and the label DEBUG.
   // Inputs : string caller --> The name of the module who invoked this task
   //          string msg    --> the message to be displayed
   // Outputs: none
   function void printDebugMsg (input string caller, input string msg);
      string temp;
      begin
         temp = {"DEBUG (", caller, "): ", msg};
   `ifdef DEBUG
         `SIM.message (temp);
   `endif         
      end
   endfunction // printMessage


   //-------------------------------------------------------------------
   //<> task tCheckSig
   // Purpose: verifies a Testbench signal is at expected value
   //   - level of warning (errlvl) is provided as 
   //       (0=info, 1=warning, 2=Error).
   // Inputs :  
   //    string  : calling process name (typically TC_NAME)
   //    integer : errlvl  // 0-2 (>2 treated as ERROR)
   //    string  : signal name 
   //    integer : real value
   //    integer : expected value
   //
   //template:
   //   tCheckSig(TC_NAME, 2, "netname" , net, expval);   // check signal sig has value 0
   //-------------------------------------------------------------------
   task tCheckSig (  input string  caller ,               // string label of calling module/procedure
                     input integer errlvl ,               // error level responce (0-2)
                     input string  sname ,                // string of signal name being checked
                     input integer unsigned realval ,     // realvalnal to be checked
                     input integer unsigned expval );     // correct value expvalected (fault if actual != expvalected)
   begin
      if (realval !== expval) begin
         case (errlvl)
            0 :      `SIM.printMessage(caller, {sname ," had unexpected value...expval= ", `V2HEXSTR(expval), ", actual= ", `V2HEXSTR(realval)});
            1 :      `SIM.printWarning(caller, {sname ," had unexpected value...expval= ", `V2HEXSTR(expval), ", actual= ", `V2HEXSTR(realval)});
           default:  `SIM.printError  (caller, {sname ," had unexpected value...expval= ", `V2HEXSTR(expval), ", actual= ", `V2HEXSTR(realval)});
         endcase
      end
   `ifndef ERROR_ONLY
      else begin
         `SIM.printMessage(caller, {sname ," matched the expected value: " , `V2HEXSTR(expval)});
      end
   `endif
   end
   endtask

   task tCheckBit (  input string   caller ,      // string label of calling module/procedure
                     input integer  errlvl ,      // error level responce (0-2)
                     input string   sname ,       // string of signal name being checked
                     input reg      realval ,     // realvalnal to be checked
                     input reg      expval );     // correct value expvalected (fault if actual != expvalected)
   begin
      if (realval !== expval) begin
         case (errlvl)
            0 :      `SIM.printMessage(caller, {sname ," had unexpected value...expval= ", `V2BINSTR(expval), ", actual= ", `V2BINSTR(realval)});
            1 :      `SIM.printWarning(caller, {sname ," had unexpected value...expval= ", `V2BINSTR(expval), ", actual= ", `V2BINSTR(realval)});
           default:  `SIM.printError  (caller, {sname ," had unexpected value...expval= ", `V2BINSTR(expval), ", actual= ", `V2BINSTR(realval)});
         endcase
      end
   `ifndef ERROR_ONLY
      else begin
         `SIM.printMessage(caller, {sname ," matched the expected value: " , `V2BINSTR(expval)});
      end
   `endif
   end
   endtask

   
   //-------------------------------------------------------------------
   //<> Task sub-test fault check
   // Purpose: to determine if sub-tests within testcase have passed or if faults occured.  
   //       Helps in logfile readability
   // Inputs :  testcase --> string name of the testcase calling (typically TC_NAME)
   //           test_name --> descriptive string name of testcase sub-test portion
   // Outputs: none
      int last_err_cnt = 0;   // test interval fault count buffer for delta check and specific test annotation
      event sub_test_done_event;
      
   task sub_test_fault_chk (input string testcase, input string test_name);
      string s_delta;
   begin
      ->sub_test_done_event;  // kick for testcase waveform flagging
      if (`SIM.globalErrorCounter > last_err_cnt) begin // check delta in fault counts since last check.
         $sformat(s_delta, "%0d", (`SIM.globalErrorCounter - last_err_cnt));
         `SIM.printMessage(testcase, {"------------------ ", test_name," - FAILED with ", s_delta," faults"});
      end
      else 
         `SIM.printMessage(testcase, {"------------------ ", test_name," - Passed"});
      last_err_cnt = `SIM.globalErrorCounter;  // update interval fault counter to current global for next test delta check
   end
   endtask
  
