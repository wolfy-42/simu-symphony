--==========================================PACKAGE HEADER==========================================
library ieee, std, work;
use ieee.std_logic_1164.all;
use std.textio.all;
use work.txt_util.all;
use work.sim_management.all;
--use work.global_signal_pkg.all;  -- contains all board-level interconnect signals for global access

package bfm_comm_traffic_pkg is
   --=========== Package constants =============
   constant SPI_WR_POL          : integer := 0;       -- polarity of write bit in SPI transaction

   --=========== Procedure headers =============
   -- generic SPI Read/Write transaction
   procedure gbl_spi_msg( w_rn: in integer;                                                -- << OK ? >>
                      header: in std_logic_vector;
                      w_dat: in std_logic_vector;
                      r_dat: out std_logic_vector;
                      signal clock : in std_logic;
                      signal rx_bit : in std_logic;
                      signal flag : out std_logic;
                      signal chipsel : out std_logic;
                      signal tx_bit : out std_logic
                      );

   -- individual pulse generation
   procedure pulse(  polarity: in integer;
                     duration : in time;
                     netname : in string;
                     signal out_sig : out std_logic
                  );


   --=========== BFM Driver component =============
   component bfm_comm_driver is
      generic ( CLK_SPI_PERIOD : time := 100 ns
         );
      port (
         -- SPI Gated clock sources
         i_spi_en_flag  : in std_logic := '0';  -- '1' starts SPI clock transaction
         o_spi_sclk  : out std_logic := '0'
      );
   end component;

end bfm_comm_traffic_pkg;

--==========================================PACKAGE BODY==========================================
package body bfm_comm_traffic_pkg is

   ------------------------------------------------------------------------
   -- spi bus (interface independant operation)
   --  - scalable input based on length of w_dat vector passed.
   --  - assumes gated clock controlled by f_*_spi_msg_xfer
   --  - MSbit out first
   ------------------------------------------------------------------------
   procedure gbl_spi_msg( w_rn: in integer;                                                -- << OK ? >>
                      header: in std_logic_vector;
                      w_dat: in std_logic_vector;
                      r_dat: out std_logic_vector;
                      signal clock : in std_logic;
                      signal rx_bit : in std_logic;
                      signal flag : out std_logic;
                      signal chipsel : out std_logic;
                      signal tx_bit : out std_logic
                      ) is
      variable x : integer; -- loop index
      variable v_read_dat : std_logic_vector(r_dat'range); -- loop index
   begin
      if (w_rn > 1) then  -- user-input fault avoidance
         printError ("bfm_comm_traffic_pkg", "spi_msg() - read/write input OOB");
         return;
      end if;
      printMessage ("spi_msg()", ("send header =" & str(header)));
      flag <= '1';   -- indicate spi transaction underway (start clock)
      chipsel   <= '0';  -- Active LOW enable chipselects
      --<>output write/read_n
      if (w_rn = SPI_WR_POL) then  -- write/read_n flag output
         tx_bit  <= '0';      -- drive write onto global net
         wait until (clock = '0'); -- on falling edge of clock...
      else
         tx_bit  <= '1';      -- drive data onto global net
         wait until (clock = '0'); -- on falling edge of clock...
      end if;
      --<>output header
      for x in header'high downto 0 loop  -- output header data
         tx_bit  <= header(x);      -- drive data onto global net
         wait until (clock = '0'); -- on falling edge of clock...
      end loop;
      --<>write/read payload
      if (w_rn = SPI_WR_POL) then      -- write cycle
         printMessage ("spi_msg()", ("Writting value = " & str(w_dat)));
         for x in w_dat'high downto 0 loop  -- output write data
            tx_bit  <= w_dat(x);      -- drive data onto global net
            wait until (clock = '0'); -- on falling edge of clock...
         end loop;
      else        -- read-cycle
         for x in r_dat'high downto 0 loop
            wait until (clock = '1'); -- read on rising edge of clock...
            v_read_dat(x) := rx_bit;       -- capture input from global net
            wait until (clock = '0'); -- on falling edge of clock...
         end loop;
         r_dat := v_read_dat;
         printMessage ("spi_msg()", ("Read returned = " & str(v_read_dat)));
      end if;
      chipsel   <= '1';  -- halt bus transaction
      tx_bit <= '0';   -- return to default rest
      flag <= '0';   -- indicate spi transaction completed
   end procedure gbl_spi_msg;


   ------------------------------------------------------------------------
   -- Procedure to generate a pulse of arbitary duration
   ------------------------------------------------------------------------
   procedure pulse(  polarity: in integer;            -- active polarity of pulse _1=high, 0=low)
                     duration : in time;              -- width of pulse in time unit
                     netname : in string;             -- signal being driven (in quotes)
                     signal out_sig : out std_logic   -- signal being driven
                  ) is
      variable active_state: std_logic;
   begin
      printMessage ("bfm_comm_traffic_pkg", ("pulse() - asserting " & netname ));
      if (polarity = 1) then
         active_state := '1';
      else
         active_state := '0';
      end if;
      out_sig <= active_state;
      wait for duration;
      out_sig <= not active_state;
   end procedure;

end bfm_comm_traffic_pkg;

--==========================ENTITY==========================================
library ieee, std, work;
use ieee.std_logic_1164.all;
use ieee.math_real.all;
use std.textio.all;
use work.txt_util.all;
use work.sim_management.all;
--use work.global_signal_pkg.all;
use work.bfm_comm_traffic_pkg.all;

entity bfm_comm_driver is
   generic ( CLK_SPI_PERIOD : time := 100 ns
      );
   port (
      -- SPI Gated clock sources
      i_spi_en_flag  : in std_logic := '0';  -- '1' starts SPI clock transaction
      o_spi_sclk  : out std_logic := '0'
   );
end bfm_comm_driver;

--==========================ARCHITECTURE==========================================
architecture bfm_driver of bfm_comm_driver is

-- INTERNAL CLOCK SIGNALS
signal gated_spi_clk            : std_logic := '0';

begin

   -----------------------------------
   -- gated clock driver for USB SPI interface clock
   p_spi_clk_drv: process
   begin
      if (sim_halt = '0') then
         if ( i_spi_en_flag = '1') then   -- wait on global flag
            wait for CLK_SPI_PERIOD/2;
            gated_spi_clk <= not gated_spi_clk;     -- initiate clock
         else
            gated_spi_clk <= '0';
            wait until (i_spi_en_flag = '1');  -- suspend process until next transaction
         end if;
      end if;
   end process;
   o_spi_sclk <= gated_spi_clk;


end bfm_driver;
