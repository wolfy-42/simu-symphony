//<> main Simulation_management heirarchy shortcut
`define SIM       tb.sim_management_inst
`define MATH      tb.lib_math_inst
`define TEXT      tb.text_utils_inst

//<> math library shortcuts
`define V2HEXSTR  tb.text_utils_inst.Vec2HexStr
`define V2INTSTR  tb.text_utils_inst.Vec2IntStr
`define V2BINSTR  tb.text_utils_inst.Vec2BinStr
`define TIME2STR  tb.text_utils_inst.Time2Str
`define HEX2ASCII tb.text_utils_inst.hex2a
`define FLOAT2STR tb.text_utils_inst.Float2Str

//<> logic high vs low (single-bit...improves code readability)
`define HIGH 1'b1
`define LOW  1'b0

